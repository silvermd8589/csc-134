#include <iostream>
#include <string>
using namespace std;

// ============================================================
// PART 1: ENUMS (names for numbers)
// The compiler counts from 0. NORTH is 0, EAST is 1, and so on.
// The last name is the count: NUM_DIRECTIONS is 4.
// ============================================================
enum Direction {
    NORTH,
    EAST,
    SOUTH,
    WEST,
    NUM_DIRECTIONS
};

const string DIRECTION_NAMES[NUM_DIRECTIONS] = {
    "north", "east", "south", "west"
};

enum Room {
    LIVING_ROOM,
    DINING_ROOM,
    KITCHEN,
    ALEX_ROOM,
    PENELOPE_ROOM,
    RINA_OFFICE,
    GUEST_BATHROOM,
    HALLWAY,
    NUM_ROOMS
};

enum Item {
    KEY,
    BUTTER_KNIFE,
    PICK_SET,
    NUM_ITEMS
};

const int INVENTORY = -2; // an item's location when the player is carrying it

int main() {
    // ============================================================
    // PART 2: ROOM DATA (parallel arrays)
    // Same index means same room.
    // ============================================================
    string roomNames[NUM_ROOMS] = {
        "Living Room",
        "Dining Room",
        "Kitchen",
        "Alex's Room",
        "Penelope Room",
        "Rina's Office",
        "Guest Bathroom",
        "Hallway",
    };

    string roomDescriptions[NUM_ROOMS] = {
        "A normal living room that is well lived in.",
        "A kitchen table with some stuff on it, a bookshelf full of books.",
        "A spacious kitchen with an island counter, stove, dishwasher and fridge.",
        "A boy room, toy cars and trucks, marvel poster on the wall and some how a bed and full recliner chair.",
        "A girl room that is some how messy and clean at the same time.",
        "A small office with a computer, shelves, and a rolling chair.",
        "A polished bathroom with a sink, mirror, tub and toilet.",
        "Just a hallway",
    };

    // ============================================================
    // ITEM DATA (parallel arrays)
    // Same index means same item. Keep the order of the Item enum.
    // ============================================================
    string itemNames[NUM_ITEMS] = { "key", "butter knife", "pick set" };
    int itemLocation[NUM_ITEMS] = { GUEST_BATHROOM, KITCHEN, LIVING_ROOM };

    // Hidden items can't be seen or taken until the player searches the room
    bool itemHidden[NUM_ITEMS] = { true, false, false };

    // Locked rooms (only the key opens them)
    bool roomLocked[NUM_ROOMS] = { false };
    roomLocked[RINA_OFFICE] = true;

    // ============================================================
    // PART 3: THE MAP (a 2D array)
    // ============================================================
    int connections[NUM_ROOMS][NUM_DIRECTIONS];
    for (int i = 0; i < NUM_ROOMS; i++) {
        for (int j = 0; j < NUM_DIRECTIONS; j++) {
            connections[i][j] = -1;
        }
    }

    connections[LIVING_ROOM][NORTH] = DINING_ROOM;

    connections[DINING_ROOM][EAST] = ALEX_ROOM;
    connections[DINING_ROOM][NORTH] = KITCHEN;
    connections[DINING_ROOM][SOUTH] = LIVING_ROOM;

    connections[KITCHEN][SOUTH] = DINING_ROOM;
    connections[KITCHEN][EAST] = PENELOPE_ROOM;
    connections[KITCHEN][NORTH] = HALLWAY;

    connections[ALEX_ROOM][WEST] = DINING_ROOM;
    connections[ALEX_ROOM][NORTH] = PENELOPE_ROOM;

    connections[PENELOPE_ROOM][WEST] = KITCHEN;
    connections[PENELOPE_ROOM][SOUTH] = ALEX_ROOM;

    connections[HALLWAY][SOUTH] = KITCHEN;
    connections[HALLWAY][EAST] = RINA_OFFICE;
    connections[HALLWAY][NORTH] = GUEST_BATHROOM;

    connections[RINA_OFFICE][WEST] = HALLWAY;

    connections[GUEST_BATHROOM][SOUTH] = HALLWAY;

    // ============================================================
    // PART 4: THE GAME LOOP
    // ============================================================
    int currentRoom = LIVING_ROOM;
    bool gameRunning = true;

    while (gameRunning) {
        cout << "\nYou are in the " << roomNames[currentRoom] << endl;
        cout << roomDescriptions[currentRoom] << endl;

        // auto pick up any visible items in this room
        for (int i = 0; i < NUM_ITEMS; i++) {
            if (itemLocation[i] == currentRoom && !itemHidden[i]) {
                itemLocation[i] = INVENTORY;
                cout << "You pick up the " << itemNames[i] << "." << endl;
            }
        }

        // show the inventory every time through the loop
        cout << "Inventory: ";
        bool carryingAnything = false;
        for (int i = 0; i < NUM_ITEMS; i++) {
            if (itemLocation[i] == INVENTORY) {
                if (carryingAnything) {
                    cout << ", ";
                }
                cout << itemNames[i];
                carryingAnything = true;
            }
        }
        if (!carryingAnything) {
            cout << "empty";
        }
        cout << endl;

        cout << "Exits: ";
        bool hasExits = false;
        for (int dir = 0; dir < NUM_DIRECTIONS; dir++) {
            if (connections[currentRoom][dir] != -1) {
                cout << DIRECTION_NAMES[dir] << " ";
                hasExits = true;
            }
        }
        if (!hasExits) {
            cout << "none";
        }
        cout << endl;

        string command;
        cout << "\nWhat would you like to do? ";
        if (!(cin >> command)) {
            break;
        }

        if (command == "north" || command == "n") {
            int nextRoom = connections[currentRoom][NORTH];
            if (nextRoom == -1) {
                cout << "You can't go that way." << endl;
            } else if (roomLocked[nextRoom] && itemLocation[KEY] != INVENTORY) {
                cout << "The door is locked. You need a key." << endl;
            } else {
                if (roomLocked[nextRoom]) {
                    cout << "You unlock the door with the key." << endl;
                    roomLocked[nextRoom] = false;
                }
                currentRoom = nextRoom;
            }
        } else if (command == "east" || command == "e") {
            int nextRoom = connections[currentRoom][EAST];
            if (nextRoom == -1) {
                cout << "You can't go that way." << endl;
            } else if (roomLocked[nextRoom] && itemLocation[KEY] != INVENTORY) {
                cout << "The door is locked. You need a key." << endl;
            } else {
                if (roomLocked[nextRoom]) {
                    cout << "You unlock the door with the key." << endl;
                    roomLocked[nextRoom] = false;
                }
                currentRoom = nextRoom;
            }
        } else if (command == "south" || command == "s") {
            int nextRoom = connections[currentRoom][SOUTH];
            if (nextRoom == -1) {
                cout << "You can't go that way." << endl;
            } else if (roomLocked[nextRoom] && itemLocation[KEY] != INVENTORY) {
                cout << "The door is locked. You need a key." << endl;
            } else {
                if (roomLocked[nextRoom]) {
                    cout << "You unlock the door with the key." << endl;
                    roomLocked[nextRoom] = false;
                }
                currentRoom = nextRoom;
            }
        } else if (command == "west" || command == "w") {
            int nextRoom = connections[currentRoom][WEST];
            if (nextRoom == -1) {
                cout << "You can't go that way." << endl;
            } else if (roomLocked[nextRoom] && itemLocation[KEY] != INVENTORY) {
                cout << "The door is locked. You need a key." << endl;
            } else {
                if (roomLocked[nextRoom]) {
                    cout << "You unlock the door with the key." << endl;
                    roomLocked[nextRoom] = false;
                }
                currentRoom = nextRoom;
            }
        } else if (command == "search" || command == "look" || command == "l") {
            bool foundSomething = false;
            for (int i = 0; i < NUM_ITEMS; i++) {
                if (itemLocation[i] == currentRoom && itemHidden[i]) {
                    itemHidden[i] = false;
                    itemLocation[i] = INVENTORY;
                    cout << "You search the room and find a " << itemNames[i] << "! You pick it up." << endl;
                    foundSomething = true;
                }
            }
            if (!foundSomething) {
                cout << "You search around but find nothing." << endl;
            }
        } else if (command == "quit" || command == "q") {
            gameRunning = false;
        } else {
            cout << "I don't understand that command." << endl;
        }
    }

    cout << "Thanks for playing!" << endl;
    return 0;
}